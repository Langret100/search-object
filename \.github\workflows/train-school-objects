name: Train and package validated 38-object model
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build-model:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Install CPU-only training dependencies
        run: |
          python -m pip install requests Pillow
          python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
          python -m pip install -r training/requirements.txt
      - name: Auto-collect and split 30 photos per class if data folder is missing
        run: |
          if [ ! -d "training/data" ] || [ -z "$(ls -A training/data 2>/dev/null)" ]; then
            python training/collect_commons.py --per-class 30
            python -c "
          import os, shutil, random
          from pathlib import Path

          src_root = Path('training/candidates')
          train_root = Path('training/data')
          val_root = Path('training/holdout')

          random.seed(42)
          for cls_dir in sorted(src_root.iterdir()):
              if not cls_dir.is_dir():
                  continue
              imgs = [p for p in cls_dir.iterdir() if p.is_file() and p.suffix.lower() in {'.jpg', '.jpeg', '.png', '.webp'}]
              random.shuffle(imgs)
              split_idx = max(1, int(len(imgs) * 0.8))
              (train_root / cls_dir.name).mkdir(parents=True, exist_ok=True)
              (val_root / cls_dir.name).mkdir(parents=True, exist_ok=True)
              for p in imgs[:split_idx]:
                  shutil.copy2(p, train_root / cls_dir.name / p.name)
              for p in imgs[split_idx:]:
                  shutil.copy2(p, val_root / cls_dir.name / p.name)
          "
          fi
      - name: Train all 38 classes against separate reviewed validation photos
        run: python training/train_model.py --data training/data --holdout training/holdout --output models
      - name: Bundle same-origin ONNX WASM runtime
        run: bash training/bundle_ort.sh
      - name: Verify and package complete application
        run: python training/package_release.py
      - uses: actions/upload-artifact@v4
        with:
          name: AI-Object-Detective-validated-38
          path: AI_Object_Detective_validated_38.zip
          if-no-files-found: error
          retention-days: 14
