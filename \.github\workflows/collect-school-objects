name: Collect candidate photos for 38 objects (review required)
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install requests Pillow
      - run: python training/collect_commons.py --per-class 80
      - uses: actions/upload-artifact@v4
        with:
          name: unreviewed-candidate-photos
          path: training/candidates/
          if-no-files-found: error
          retention-days: 14
